+    /// Empty the set and size it for values in `0..capacity`, keeping
+    /// the existing buffers when they already fit. Stale `sparse`
+    /// slots are harmless: `insert` trusts a slot only when `dense`
+    /// confirms it, and `dense` is cleared here.
+    pub fn reset(&mut self, capacity: usize) {
+        if self.sparse.len() < capacity {
+            self.sparse.clear();
+            self.sparse.resize(capacity, usize::MAX);
+            self.dense.reserve(capacity);
