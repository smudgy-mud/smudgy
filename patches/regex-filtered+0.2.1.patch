+thread_local! {
+    /// The idle working buffers of this thread: the mapper scratch plus
+    /// the candidate list it fills. A match takes them out, works in
+    /// them, and hands them back when its [`Candidates`] drops, so steady
+    /// state matching allocates nothing. The slot is empty while a match
+    /// is in flight; a nested or overlapping match on the same thread
+    /// then starts from fresh (empty) buffers, and whichever finishes
+    /// last leaves its buffers behind. Any number of sets share the
+    /// slot, as the buffers are resized for the mapper on every use.
+    static SCRATCH: RefCell<(mapper::Scratch, Vec<usize>)> =
+        const { RefCell::new((mapper::Scratch::new(), Vec::new())) };
+}
+
+/// The indices of the regexes the prefilter could not rule out for one
+/// haystack, ascending. Owns the buffers it was computed in and returns
+/// them to the pool of the thread it is dropped on.
+struct Candidates {
+    scratch: mapper::Scratch,
+    candidates: Vec<usize>,
+    next: usize,
+}
+
+impl Iterator for Candidates {
+    type Item = usize;
+
+    #[inline]
+    fn next(&mut self) -> Option<usize> {
+        let idx = *self.candidates.get(self.next)?;
+        self.next += 1;
+        Some(idx)
+    }
+
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        let n = self.candidates.len() - self.next;
+        (n, Some(n))
+    }
+}
+
+impl ExactSizeIterator for Candidates {}
+
+impl Drop for Candidates {
+    fn drop(&mut self) {
+        // Unreachable only while the thread's locals are being torn
+        // down; the buffers are then simply freed.
+        let _ = SCRATCH.try_with(|slot| {
+            *slot.borrow_mut() = (
+                mem::take(&mut self.scratch),
+                mem::take(&mut self.candidates),
+            );
+        });
+    }
+}
