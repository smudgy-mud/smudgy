+    fn a_byte_cutting_a_utf8_sequence_short_is_parsed_afresh() {
+        // An ESC after a lone lead byte begins its sequence.
+        assert_eq!(
+            parse_as_vec(b"\xe3\x1b[31m"),
+            vec![
+                VTAction::Print('\u{fffd}'),
+                VTAction::CsiDispatch {
+                    params: vec![CsiParam::Integer(31)],
+                    parameters_truncated: false,
+                    byte: b'm',
+                }
+            ]
+        );
+        // So does one after a sequence two bytes in, and ASCII prints.
+        assert_eq!(
+            parse_as_vec(b"\xf0\x9f\x1b_x\x1b\\\xe3\x81a"),
+            vec![
+                VTAction::Print('\u{fffd}'),
+                VTAction::ApcDispatch(b"x".to_vec()),
+                VTAction::EscDispatch {
+                    params: vec![],
+                    intermediates: vec![],
+                    ignored_excess_intermediates: false,
+                    byte: b'\\',
+                },
+                VTAction::Print('\u{fffd}'),
+                VTAction::Print('a'),
+            ]
+        );
+        // A lead byte cutting a sequence short begins its own.
+        assert_eq!(
+            parse_as_vec(b"\xe3\xe3\x81\x82"),
+            vec![VTAction::Print('\u{fffd}'), VTAction::Print('\u{3042}')]
+        );
+        // A continuation byte the sequence cannot take is still dropped
+        // with it.
+        assert_eq!(
+            parse_as_vec(b"\xe0\x80a"),
+            vec![VTAction::Print('\u{fffd}'), VTAction::Print('a')]
+        );
