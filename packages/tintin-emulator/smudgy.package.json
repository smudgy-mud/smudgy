{
    "version": "0.0.6",
    "description": "Type TinTin++ commands at the input line: #alias, #action, #variable, #showme and friends become native smudgy automations.",
    "entry": "index.ts",
    "min_smudgy_version": "0.5.7",
    "params": [
        {
            "key": "commandChar",
            "label": "Command character",
            "type": "string",
            "default": "#"
        },
        {
            "key": "speedwalk",
            "label": "Enable TinTin speedwalks",
            "type": "bool",
            "default": false
        }
    ],
    "permissions": {
        "read": ["$DATA"],
        "write": ["$DATA"],
        "smudgy": {
            "input": ["access"],
            "interop": ["read"],
            "automations": ["aliases", "triggers"],
            "session": ["send", "send-direct", "echo", "reach-others"],
            "display": ["change"],
            "panes": ["create"]
        }
    }
}
