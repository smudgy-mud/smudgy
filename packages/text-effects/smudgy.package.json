{
  "version": "0.1.0",
  "description": "Independently importable GPU text effects with an interactive playground at the package root.",
  "entry": "index.tsx",
  "importable": true,
  "min_smudgy_version": "0.5.8",
  "permissions": {
    "smudgy": {
      "widgets": [
        "create",
        "shaders"
      ],
      "session": [
        "echo"
      ],
      "panes": [
        "create"
      ],
      "automations": [
        "aliases"
      ]
    }
  }
}
