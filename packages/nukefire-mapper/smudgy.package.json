{
  "version": "0.18.3",
  "description": "Maps NukeFire from its rich NukeFire.Map.Local GMCP snapshots.",
  "entry": "index.ts",
  "min_smudgy_version": "0.5.8",
  "dependencies": [
    "smudgy://kapusniak/nukefire-gmcp",
    "smudgy://kapusniak/map-layout@^0.2.7"
  ],
  "requires": [
    "smudgy://kapusniak/nukefire-gmcp"
  ],
  "hosts": [
    "tdome.nukefire.org"
  ],
  "params": [
    {
      "key": "areaNameRules",
      "label": "Area name rules (reconnect after editing)",
      "type": "table",
      "fields": [
        {
          "key": "name",
          "label": "Area name the game shows",
          "type": "string",
          "required": true
        },
        {
          "key": "map",
          "label": "Map it belongs in",
          "type": "string",
          "required": true
        },
        {
          "key": "exactCase",
          "label": "Match this exact capitalization",
          "type": "bool",
          "default": false
        }
      ]
    },
    {
      "key": "debugMappingDecisions",
      "label": "Log mapping decisions (debug)",
      "type": "bool",
      "default": false
    }
  ],
  "permissions": {
    "write": [
      "$DATA"
    ],
    "smudgy": {
      "automations": [
        "aliases"
      ],
      "session": [
        "echo",
        "reach-others"
      ],
      "mapper": [
        "write"
      ],
      "interop": [
        "read",
        "write"
      ],
      "gmcp": [
        "send"
      ],
      "workers": [
        "spawn"
      ]
    }
  }
}
