{
    "name": "auto-mapper",
    "version": "0.3.6",
    "description": "Follows your position from GMCP or MSDP room data and auto-draws durable local maps as you explore.",
    "min_smudgy_version": "0.5.5",
    "dependencies": [
        "smudgy://kapusniak/map-layout@^0.2.1"
    ],
    "permissions": {
        "smudgy": {
            "interop": ["read"],
            "mapper": ["write"],
            "automations": ["aliases"],
            "session": ["echo"],
            "gmcp": ["send"],
            "workers": ["spawn"]
        }
    }
}
