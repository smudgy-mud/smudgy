{
    "name": "rop-mapper",
    "version": "0.2.1",
    "description": "Rites of Passage mapper using authoritative Room.Info exits and Room.Map neighborhoods, with explicit cloud upgrade.",
    "min_smudgy_version": "0.5.5",
    "dependencies": [
        "smudgy://official/auto-mapper@^0.3.6"
    ],
    "hosts": [
        "play.ropmud.com"
    ],
    "permissions": {
        "smudgy": {
            "interop": ["read"],
            "mapper": ["write"],
            "automations": ["aliases"],
            "session": ["echo"],
            "gmcp": ["send"],
            "workers": ["spawn"]
        }
    }
}
