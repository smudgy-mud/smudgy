{
  "version": "0.5.1",
  "description": "NukeFire widgets deck: vitals, maps + GPS, comms and more",
  "entry": "index.ts",
  "min_smudgy_version": "0.5.5",
  "dependencies": [
    "smudgy://kapusniak/nukefire-gmcp",
    "smudgy://kapusniak/map-layout@^0.2.1"
  ],
  "requires": [
    "smudgy://kapusniak/nukefire-gmcp",
    "smudgy://kapusniak/nukefire-mapper"
  ],
  "hosts": [
    "tdome.nukefire.org"
  ],
  "params": [
    {
      "key": "showHud",
      "label": "Show vitals HUD / session summary",
      "type": "bool",
      "default": true
    },
    {
      "key": "showAffects",
      "label": "Show Affects pane",
      "type": "bool",
      "default": true
    },
    {
      "key": "showComms",
      "label": "Show Comms pane",
      "type": "bool",
      "default": true
    },
    {
      "key": "showMap",
      "label": "Show Map pane",
      "type": "bool",
      "default": true
    },
    {
      "key": "showRadar",
      "label": "Show BIGMAP radar pane",
      "type": "bool",
      "default": false
    },
    {
      "key": "showAtlas",
      "label": "Show GPS Atlas tab",
      "type": "bool",
      "default": true
    },
    {
      "key": "showDeck",
      "label": "Show context Deck pane",
      "type": "bool",
      "default": true
    },
    {
      "key": "showCodex",
      "label": "Show Codex pane",
      "type": "bool",
      "default": false
    },
    {
      "key": "chatRendering",
      "label": "Chat rendering",
      "type": "dropdown",
      "default": "full-ansi",
      "options": [
        {
          "value": "full-ansi",
          "label": "Full ANSI"
        },
        {
          "value": "plain",
          "label": "Plain"
        }
      ]
    },
    {
      "key": "chatFontSize",
      "label": "Chat font size (px)",
      "type": "number",
      "default": 12
    },
    {
      "key": "separateChatMessages",
      "label": "Separate chat messages with empty lines",
      "type": "bool",
      "default": true
    },
    {
      "key": "widgetFontSize",
      "label": "Widget font size (px)",
      "type": "number",
      "default": 12
    },
    {
      "key": "sessionLayout",
      "label": "Additional session layout",
      "type": "dropdown",
      "default": "tabbed",
      "options": [
        {
          "value": "stacked-right",
          "label": "Stack sessions on the right"
        },
        {
          "value": "tabbed",
          "label": "All sessions in one set of tabs"
        }
      ]
    },
    {
      "key": "sessionVitalsLayout",
      "label": "Tabbed-session vitals style",
      "type": "dropdown",
      "default": "wide",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    }
  ],
  "permissions": {
    "write": [
      "$DATA"
    ],
    "smudgy": {
      "automations": [
        "aliases",
        "triggers"
      ],
      "session": [
        "send",
        "echo",
        "reach-others"
      ],
      "mapper": [
        "write"
      ],
      "display": [
        "change"
      ],
      "widgets": [
        "create"
      ],
      "interop": [
        "read",
        "write"
      ],
      "panes": [
        "create"
      ],
      "gmcp": [
        "send"
      ],
      "input": [
        "access"
      ],
      "workers": [
        "spawn"
      ]
    }
  }
}
